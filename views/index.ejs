<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Members Only Club</title>
</head>
<body>
  <h1>Welcome to the Clubhouse!</h1>

  <!-- Navigation / Authentication status -->
  <% if (user) { %>
    <p>Hello, <strong><%= user.first_name %></strong>! (Status: <%= user.membership_status %>)</p>
    
    <p>
      <a href="/new-message">Create a new message</a> | 
      <% if (user.membership_status !== 'member') { %>
        <a href="/join-club">Join the Club</a> | 
      <% } %>
      <a href="/log-out">Log Out</a>
    </p>
  <% } else { %>
    <p>
      <a href="/log-in">Log In</a> | 
      <a href="/sign-up">Sign Up</a>
    </p>
  <% } %>

  <hr>

  <h2>Club Messages</h2>
  
  <% if (messages.length === 0) { %>
    <p>No messages yet. Be the first to write one!</p>
  <% } else { %>
    <ul>
      <% messages.forEach(msg => { %>
        <li style="margin-bottom: 20px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
          <h3><%= msg.title %></h3>
          <p><%= msg.text %></p>

          <!-- Conditional Author/Date display -->
          <% if (user && user.membership_status === 'member') { %>
            <small style="color: green;">
              Posted by: <%= msg.first_name %> <%= msg.last_name %> on <%= msg.added %>
            </small>
          <% } else { %>
            <small style="color: gray;">
              Posted by: Anonymous 🔒 (Join the club to see authors and dates!)
            </small>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

</body>
</html>
